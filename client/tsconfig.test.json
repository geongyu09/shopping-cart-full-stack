{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    "types": ["vite/client", "node", "jest", "@testing-library/jest-dom"],
    "noEmit": true
  },
  "include": [
    "src",
    "jest.setup.ts",
    "src/**/*.test.ts",
